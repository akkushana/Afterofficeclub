# Optional community destinations; empty values are intentionally not rendered.
NEXT_PUBLIC_WHATSAPP_COMMUNITY_URL=
NEXT_PUBLIC_TELEGRAM_CHANNEL_URL=
NEXT_PUBLIC_DISCORD_INVITE_URL=
